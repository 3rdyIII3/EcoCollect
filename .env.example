# ---- Server-side (Vercel project settings -> Environment Variables) ----

# Neon connection string. Dashboard -> Connection Details -> "Pooled connection".
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/ecocollect?sslmode=require

# Signs session JWTs. MUST be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# IANA timezone used for "today", "this month" and weekday schedules.
# Ipil, Zamboanga Sibugay is Asia/Manila. Vercel itself runs in UTC, so this is
# what keeps a 07:00 collection counting as "today".
APP_TIMEZONE=Asia/Manila