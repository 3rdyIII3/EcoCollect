# This folder is a Node project that lives under C:\xampp\htdocs so it sits next to
# the original PHP app. Apache must not serve it: node_modules, .env and source
# would all be world-readable to anyone on the network.
#
# Local development goes through the dev server / Vercel, never through Apache.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
